{
  "name": "wacss",
  "version": "0.0.2",
  "description": "A semantic, token-driven, class-light CSS system and Astro component library inspired by Wabi-Sabi and editorial minimalism.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "files": [],
  "exports": {},
  "scripts": {
    "generate:tokens": "bun scripts/generate-tokens.ts",
    "build": "bun run generate:tokens && astro build",
    "dev": "bun run generate:tokens && astro dev",
    "preview": "astro preview",
    "build:book": "typst compile --root . --input theme=dark design/book.typ design/wacss-spec.pdf && typst compile --root . --input theme=light design/book.typ design/wacss-spec-light.pdf",
    "theme-swatches": "bun scripts/theme-swatches.ts"
  },
  "devDependencies": {
    "@astrojs/svelte": "9.1.6",
    "@types/bun": "latest",
    "@types/ramda": "^0.32.0",
    "astro": "7.4.13",
    "cssnano": "^9.9.0",
    "lightningcss": "^1.33.0",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "ramda": "^0.32.0",
    "sass": "^1.108.2",
    "svelte": "^5.57.3"
  },
  "peerDependencies": {
    "astro": "",
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "dependencies": {
    "@xyflow/svelte": "^1.7.1",
    "bits-ui": "^2.20.6",
    "change-case": "^5.4.4",
    "dhall-wasm": "github:consoleillusion/dhall-wasm",
    "load-object": "github:consoleillusion/js-load-object"
  }
}
