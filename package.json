{
  "name": "wacss",
  "version": "0.1.0",
  "description": "A semantic, token-driven, class-light CSS system and Astro component library inspired by Wabi-Sabi and editorial minimalism.",
  "type": "module",
  "private": false,
  "files": [
    "dist",
    "src/components",
    "src/islands",
    "src/spec",
    "src/styles",
    "scripts"
  ],
  "exports": {
    ".": "./src/components/index.ts",
    "./components": "./src/components/index.ts",
    "./spec": "./src/spec/index.ts",
    "./styles": "./dist/wacss.css",
    "./styles.min": "./dist/wacss.min.css",
    "./styles/source": "./src/styles/wacss.scss",
    "./components/*": "./src/components/*",
    "./islands/*": "./src/islands/*"
  },
  "scripts": {
    "build": "bun scripts/emit-tokens.mjs && bun scripts/build.js",
    "build:demo": "bun scripts/emit-tokens.mjs && bun scripts/build.js && astro build",
    "emit:tokens": "bun scripts/emit-tokens.mjs",
    "verify:tokens": "bun scripts/emit-tokens.mjs --check && bun scripts/audit-tokens.mjs",
    "tokens:show": "bun scripts/emit-tokens.mjs --show",
    "dev": "astro dev",
    "preview": "astro preview",
    "check": "biome check .",
    "audit:tokens": "bun scripts/audit-tokens.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "latest",
    "astro": "7.4.7",
    "sass": "^1.101.0",
    "@astrojs/svelte": "^9.1.2",
    "json-schema-typed": "^8.0.2",
    "svelte": "^5.57.3"
  },
  "peerDependencies": {
    "astro": "",
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@svar-ui/svelte-grid": "^2.7.6",
    "@xyflow/svelte": "^1.7.1",
    "bits-ui": "^2.20.6",
    "cssnano": "^9.9.0",
    "elkjs": "^0.12.1",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0"
  }
}
