---
// A component's section on /components: every variant inline, then every state in an accordion.
import data from "../../dist/tokens.json";
import Accordion from "../components/Accordion/Accordion.svelte";
import Sample from "./Sample.astro";

const { title } = Astro.props as { title: string };
const components = data.components as Record<string, any>;
const info = components[title];
const parts = [title, ...info.parts];
const states = [...new Set(parts.flatMap((p) => components[p].states))].filter((s) => s !== "static");
---
<section class="stack" id={info.name}>
  <h2>{title}</h2>
  <p>{info.description}</p>
  <div class="cluster demo-row">
    {info.variants.map((v: string) => <Sample title={title} variant={v} />)}
  </div>
  {states.length > 0 && (
    <Accordion client:load type="multiple" items={states.map((s) => ({ value: `state-${s}`, title: `State: ${s}` }))}>
      {states.map((s) => (
        <div slot={`state-${s}`} class="cluster demo-row">
          {info.variants.map((v: string) => <Sample title={title} variant={v} state={s} />)}
        </div>
      ))}
    </Accordion>
  )}
</section>
