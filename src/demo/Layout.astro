---
// The demo page shell: mode and palette bootstrap, stylesheet, navbar with palette and mode controls.
import "../../dist/wacss.css";
import "./demo.scss";
import data from "../../dist/tokens.json";
import { site } from "../site";
import NavBar from "../components/NavBar/NavBar.astro";
import Page from "../components/Page/Page.astro";

const { title, path } = Astro.props as { title: string; path: string };
const palettes = data.colors.palettes.map((p: { name: string }) => p.name);
const channels = Object.fromEntries(Object.entries(data.components).map(([k, v]: [string, any]) => [k, { name: v.name, element: v.element, variants: v.variants, channels: v.channels }]));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.title}</title>
    <link rel="icon" href="/favicon.svg" />
    <!-- Flash prevention: restore palette and mode before the first paint. -->
    <script is:inline define:vars={{ palettes }}>
      try {
        const t = localStorage.getItem("wacss:mode"), p = localStorage.getItem("wacss:palette");
        if (t) document.documentElement.dataset.mode = t;
        // A remembered palette is restored only while wacss still ships it.
        if (p && palettes.includes(p)) document.documentElement.dataset.palette = p;
      } catch {}
    </script>
  </head>
  <Page>
    <NavBar
      title={site.title}
      href="/component"
      current={path}
      links={site.nav.map((href) => ({ href, label: site.pages[href]!.title }))}
      end={[
        { component: "Select", data: { label: "Palette", id: "palette", options: palettes } },
        { component: "Button", data: { id: "mode", variant: "tertiary", "aria-live": "polite" } },
      ]}
    />
    <main class="center stack demo-main">
      <h1>{title}</h1>
      <slot />
    </main>
    <script type="application/json" id="wacss-channels" set:html={JSON.stringify(channels)}></script>
    <script>
      // Mode toggle: shows the current state (sun = light on, moon = dark on) and persists it.
      const root = document.documentElement;
      const button = document.getElementById("mode")!;
      const palette = document.getElementById("palette") as HTMLSelectElement;
      const isLight = () =>
        // Purpose: the mode currently in effect, explicit or from the system
        root.dataset.mode ? root.dataset.mode === "light" : matchMedia("(prefers-color-scheme: light)").matches;
      const remember = (key: string, value: string) => {
        // Purpose: store a choice for the next visit, where the browser allows storage
        try { localStorage.setItem(key, value); } catch {}
      };
      const show = () => {
        // Purpose: render the toggle's state as an icon and a label
        button.textContent = isLight() ? "☀ Light mode on" : "☾ Dark mode on";
      };
      button.addEventListener("click", () => {
        root.dataset.mode = isLight() ? "dark" : "light";
        remember("wacss:mode", root.dataset.mode);
        show();
      });
      palette.value = root.dataset.palette ?? palette.options[0]!.value;
      palette.addEventListener("change", () => {
        root.dataset.palette = palette.value;
        remember("wacss:palette", palette.value);
      });
      show();

      // State selector on a component's page: applies the chosen state to the variants beside it.
      // Hover, focus and active cannot be set on an element, so the element's channel properties
      // are pointed at that state's tokens; the other states are applied as the real attributes.
      type Info = { name: string; element?: string[]; variants: string[]; channels: Record<string, string[]> };
      const infos: Record<string, Info> = JSON.parse(document.getElementById("wacss-channels")!.textContent!);
      const ATTRIBUTES: Record<string, [string, string]> =
        { disabled: ["aria-disabled", "true"], loading: ["aria-busy", "true"], open: ["aria-expanded", "true"], pressed: ["aria-pressed", "true"] };
      const applied = new Map<HTMLElement, { properties: string[]; attributes: [string, string | null][] }>();
      const clear = (el: HTMLElement) => {
        // Purpose: undo whatever the selector applied to an element
        const was = applied.get(el);
        if (!was) return;
        for (const p of was.properties) el.style.removeProperty(p);
        for (const [name, value] of was.attributes) value === null ? el.removeAttribute(name) : el.setAttribute(name, value);
        if (el instanceof HTMLButtonElement) el.disabled = false;
        applied.delete(el);
      };
      const apply = (row: HTMLElement, state: string) => {
        // Purpose: show every variant in a row in one state
        const info = infos[row.dataset.demoComponent!]!;
        const selector = info.element ? info.element.join(", ") : `.${info.name}`;
        // Only the live instances beside the selector, never the selector itself.
        const instances = [...row.querySelectorAll<HTMLElement>("[data-demo-instance]")];
        const targets = instances.flatMap((i) => [...(i.matches(selector) ? [i] : []), ...i.querySelectorAll<HTMLElement>(selector)]);
        for (const el of targets) {
          clear(el);
          if (state === "static") continue;
          const record = { properties: [] as string[], attributes: [] as [string, string | null][] };
          const attribute = ATTRIBUTES[state];
          if (attribute) {
            record.attributes.push([attribute[0], el.getAttribute(attribute[0])]);
            el.setAttribute(attribute[0], attribute[1]);
          } else {
            const variant = info.variants.find((v) => el.classList.contains(v)) ?? "secondary";
            for (const token of info.channels[state] ?? []) {
              const prefix = `--${info.name}-${variant}-`;
              if (!token.startsWith(prefix)) continue;
              const property = token.slice(prefix.length, -(state.length + 1));
              if (property.startsWith("after-")) continue;
              el.style.setProperty(property, `var(${token})`);
              record.properties.push(property);
            }
          }
          applied.set(el, record);
        }
      };
      for (const select of document.querySelectorAll<HTMLSelectElement>("select[data-demo-states]"))
        select.addEventListener("change", () => apply(select.closest<HTMLElement>("[data-demo-component]")!, select.value));
    </script>
  </Page>
</html>
