---
// One instance of a component in a given variant. Framed (the default), it is shown in the
// figure of a card whose header names the variant, placed through the card's figure slot so a
// reactive component (Accordion) is still hydrated. Unframed, it is shown on its own under a
// small label naming the variant.
import Card from "../components/Card/Card.astro";
import Instance from "./Instance.astro";
import { samples } from "./samples";

const { title, variant = "secondary", framed = true } = Astro.props as { title: string; variant?: string; framed?: boolean };
const data: Record<string, any> = { ...samples[title], ...(variant === "secondary" ? {} : { variant }) };
---
{framed ? (
  <div class="demo-sample">
    <Card header={variant}>
      <Instance slot="figure" title={title} data={data} />
    </Card>
  </div>
) : (
  <div class="demo-sample demo-bare" data-demo-instance>
    <small>{variant}</small>
    <Instance title={title} data={data} />
  </div>
)}
