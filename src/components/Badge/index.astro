---
import {loadPropDefaults} from "../../loadPropDefaults.js"
import schema from "./schema.yaml"
const props = await loadPropDefaults(schema,Astro.props)
---

<span class={`badge badge-${props.variant} badge-${props.size}`}>
  {props.icon && <i class="badge-icon" data-icon={props.icon}></i>}
  {props.text}
</span>

<style>
.badge {
  display: inline-flex;
  align-items: center;
  gap: 0.25em;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
  border-radius: 9999px;
}

.badge-sm {
  padding: 0.125em 0.5em;
  font-size: 0.75rem;
}
.badge-md {
  padding: 0.25em 0.75em;
  font-size: 0.875rem;
}
.badge-lg {
  padding: 0.375em 1em;
  font-size: 1rem;
}

.badge-primary {
  background: var(--color-accent-1, #c0cfb2);
  color: var(--color-base, #fff);
}
.badge-secondary {
  background: var(--color-accent-2, #44624a);
  color: var(--color-base, #fff);
}
.badge-success {
  background: var(--color-success, #2e7d32);
  color: #fff;
}
.badge-warning {
  background: var(--color-warning, #f57c00);
  color: #fff;
}
.badge-error {
  background: var(--color-error, #c62828);
  color: #fff;
}
.badge-info {
  background: var(--color-info, #1565c0);
  color: #fff;
}
</style>
