---
import ThemeToggle from "../islands/ThemeToggle.svelte";

interface Props {
  current?: string;
}

const { current } = Astro.props;

const links = [
  { href: "/", label: "Home" },
  { href: "/components/", label: "Components" },
];
---
<header data-wacss="site-header">
  <nav aria-label="Primary" data-wacss="site-nav">
    <a href="/" data-wacss="site-brand">wacss</a>
    <ul data-wacss="site-nav-links">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={current === link.href ? "page" : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div data-wacss="site-nav-actions">
      <ThemeToggle client:load />
    </div>
  </nav>
</header>
