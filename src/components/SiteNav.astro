---
import ThemeToggle from "../islands/ThemeToggle.svelte";

interface Props {
  current?: string;
}

const { current } = Astro.props;

const links = [
  { href: "/", label: "Home" },
  { href: "/component/", label: "Components" },
];
---
<header>
  <nav aria-label="Primary">
    <a href="/">wacss</a>
    <ul>
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={current === link.href ? "page" : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div>
      <ThemeToggle client:load />
    </div>
  </nav>
</header>
