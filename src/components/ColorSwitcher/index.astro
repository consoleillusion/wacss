---
/*
import {loadPropDefaults} from "../../loadPropDefaults.js"
import schema from "./schema.yaml"
const props = await loadPropDefaults(schema,Astro.props)
*/
const hues = Array.from({length:72},(v,i)=>i)
---

<div id="color-switcher" class="color-switcher">
  { hues.map( hue =>
    <input type="radio" name="color" id={"input-"+hue}  />
    <label id={"label-"+hue} for={"input-"+hue}></label>
  )}
</div>

    <!--
    <label for={"input-"+hue} style={`background:oklch(.6 .2 ${hue*5})`}></label>
    -->
<style is:global lang="scss">

  :root {
    @for $i from 0 through 71 {
      --color-#{$i}: oklch(.6 .2 #{$i * 5});
    }
  }
    @for $i from 0 through 71 {
      label[for="input-#{$i}"]{
        background: var(--color-#{$i});
        --i: #{$i}; /* set per item */
      }

      :root:has(#color-switcher #input-#{$i}:checked) {
        --color-accent: var(--color-#{$i});
      }
    }
  #color-switcher {
    display:flex;
    flex-wrap:wrap;
    input{position:relative; opacity:0;display:none;}
    label{cursor: pointer;}
  }
  #color-switcher {
  --n: 72;        /* count */
  --r: 4rem;     /* radius */
  position: relative;
  width: calc(2 * var(--r));
  aspect-ratio: 1;
  border-radius: 50%;   /* clips the square corners into a disc */
  overflow: hidden;
}

#color-switcher > * {
  position: absolute;
  inset: 0;
  margin: 0;
  /* pivot at the disc's center, rotate into the slot */
  transform-origin: center;
  transform: rotate(calc(360deg / var(--n) * var(--i)));
  /* clip each element to one (360/n)° wedge from the center */
  clip-path: polygon(
  50% 50%,
  calc(50% - 4.37%) 0%,
  calc(50% + 4.37%) 0%
);
}
</style>
