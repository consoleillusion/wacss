---
import {loadPropDefaults} from "../../loadPropDefaults.js"
import schema from "./schema.yaml"
import "./index.scss"
const props = await loadPropDefaults(schema,Astro.props)
---

<table class="table">
  { props.caption && <caption>{props.caption}</caption> }
  { props.headers.length > 0 &&
    <thead>
      <tr>
        { props.headers.map(h =>
          <th>{h}</th>
        )}
      </tr>
    </thead>
  }
  <tbody>
    { (props.rows || []).map(row =>
      <tr>
        { row.map(cell =>
          <td>{cell}</td>
        )}
      </tr>
    )}
  </tbody>
</table>
