---
// Table: rows of data under named columns, driven by data. Styled by the generated `table`
// element rules, which style its cells (th, td) as its part, cell. A value given as
// { component, data } is that component, loaded by title; the table imports none of them.
const modules = import.meta.glob<{ default: any }>(["../*/*.svelte", "../*/*.astro", "!./Table.astro"]);

type Child = { component: string; data?: Record<string, unknown> };

const isChild = (value: unknown): value is Child =>
  // Purpose: whether a cell's value is another component, given as data
  typeof value === "object" && value !== null && typeof (value as Child).component === "string";

async function load(child: Child) {
  // Purpose: the component a child names, with its data, or undefined
  const name = child.component;
  if (!/^[A-Z][A-Za-z0-9]*$/.test(name)) return undefined;
  const loader = modules[`../${name}/${name}.svelte`] ?? modules[`../${name}/${name}.astro`];
  return loader ? { Component: (await loader()).default, data: child.data ?? {} } : undefined;
}

const { columns = [], rows = [], caption, class: className, ...rest } = Astro.props as {
  columns: { key: string; label?: string }[];
  rows: Record<string, unknown>[];
  caption?: string;
  [key: string]: any;
};
// Each row's cells, in column order: text as it is, components loaded.
const cells = await Promise.all(rows.map((r) => Promise.all(columns.map(async (c) => {
  const value = r[c.key];
  return isChild(value) ? { child: await load(value) } : { text: value ?? "" };
}))));
---
<table class={className} {...rest}>
  {caption && <caption>{caption}</caption>}
  <thead>
    <tr>{columns.map((c) => <th scope="col">{c.label ?? c.key}</th>)}</tr>
  </thead>
  <tbody>
    {cells.map((row) => (
      <tr>{row.map((cell) => <td>{"child" in cell ? cell.child && <cell.child.Component {...cell.child.data} /> : cell.text}</td>)}</tr>
    ))}
  </tbody>
</table>
