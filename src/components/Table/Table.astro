---
// Table: rows of data under named columns, driven by data. Styled by the generated `table`
// element rules; its cells are TableCells.
import TableCell from "../TableCell/TableCell.astro";
const { columns = [], rows = [], caption, class: className, ...rest } = Astro.props as {
  columns: { key: string; label?: string }[];
  rows: Record<string, unknown>[];
  caption?: string;
  [key: string]: any;
};
---
<table class={className} {...rest}>
  {caption && <caption>{caption}</caption>}
  <thead>
    <tr>{columns.map((c) => <TableCell header>{c.label ?? c.key}</TableCell>)}</tr>
  </thead>
  <tbody>
    {rows.map((r) => <tr>{columns.map((c) => <TableCell>{r[c.key] ?? ""}</TableCell>)}</tr>)}
  </tbody>
</table>
