---
const {
  type = "button"
  , variant = "default"
  , size = "default"
  , disabled = false
  , ...attrs
} = Astro.props;
const dataVariant = variant === "default" ? "secondary" : variant;
---
<button
  type={type}
  disabled={disabled}
  data-variant={dataVariant}
  data-size={size}
  {...attrs}
><slot /></button>
