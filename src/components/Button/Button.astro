---
const {
  href,
  type = "button",
  variant = "secondary",
  disabled = false,
  loading = false,
  class: className = "",
  ...attrs
} = Astro.props as any;

const classNames = [variant !== "secondary" ? variant : "", className].filter(Boolean).join(" ") || undefined;
---
{href ? (
  <a
    {...attrs}
    href={href}
    class={classNames}
    aria-disabled={disabled || loading ? "true" : undefined}
    aria-busy={loading || undefined}
    tabindex={disabled || loading ? -1 : undefined}
  ><slot /></a>
) : (
  <button
    type={type}
    disabled={disabled || loading}
    class={classNames}
    aria-busy={loading || undefined}
    {...attrs}
  ><slot /></button>
)}
