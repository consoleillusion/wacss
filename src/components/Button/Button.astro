---
const {
  href
  , type = "button"
  , variant = "default"
  , size = "default"
  , disabled = false
  , class: className = ""
  , ...attrs
} = Astro.props;
const VARIANT_CLASS = {
  default: "", secondary: "", primary: "primary"
  , destructive: "danger", link: "tertiary", outline: "tertiary"
  , info: "informational", warning: "warning"
} as Record<string, string>;
const variantClass = VARIANT_CLASS[variant] ?? "";
const classNames = [variantClass, className].filter(Boolean).join(" ") || undefined;
---
{href ? (
  <a
    {...attrs}
    href={href}
    class={classNames}
    data-size={size}
    aria-disabled={disabled ? "true" : undefined}
    tabindex={disabled ? -1 : undefined}
  ><slot /></a>
) : (
  <button
    type={type}
    disabled={disabled}
    class={classNames}
    data-size={size}
    {...attrs}
  ><slot /></button>
)}
