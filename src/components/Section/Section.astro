---
// Section: structure only. Actions are other components, given as data ({ component, data })
// and loaded by title; the band imports none of them.
const modules = import.meta.glob<{ default: any }>(["../*/*.svelte", "../*/*.astro"], { eager: true });

type Child = { component?: string; data?: Record<string, unknown> };

const load = (child?: Child) => {
  // Purpose: the component a child names, or undefined
  const name = child?.component;
  if (typeof name !== "string" || !/^[A-Z][A-Za-z0-9]*$/.test(name)) return undefined;
  return (modules[`../${name}/${name}.svelte`] ?? modules[`../${name}/${name}.astro`])?.default;
};

const {
  as: Tag = "section",
  wash,
  title,
  text,
  actions = [],
  centered = false,
  variant = "secondary",
  class: className = "",
  style,
  ...rest
} = Astro.props as Record<string, any>;

const classes = ["section", variant === "secondary" ? "" : variant, className].filter(Boolean).join(" ");
const washStyle = wash ? `--section-wash: ${wash};` : "";
const allStyles = [washStyle, style].filter(Boolean).join(" ") || undefined;
---
<Tag class={classes} style={allStyles} {...rest}>
  <div class="center stack" style={centered ? "text-align: center" : undefined}>
    {title && <h2>{title}</h2>}
    {text && <p>{text}</p>}
    <slot />
    {actions.length > 0 && (
      <div class="cluster" style={centered ? "--cluster-justify: center" : undefined}>
        {actions.map((action: Child) => {
          const Action = load(action);
          return Action && <Action {...action.data ?? {}} />;
        })}
      </div>
    )}
  </div>
</Tag>
