---
import {loadPropDefaults} from "../../loadPropDefaults.js"
import schema from "./schema.yaml"
import Field from '../Field/index.astro'
const props = await loadPropDefaults(schema,Astro.props)
---

<form>
  {JSON.stringify(props)}
  {props.fields.map((schema,idx)=> 
    <Field {schema}/>
  )}
</form>

<style>
  input {
  border: 1px solid #ccc;
  padding: 0.5rem;
}

input:invalid {
  border-color: #d32f2f;
}

input:valid {
  border-color: #2e7d32;
}
</style>
