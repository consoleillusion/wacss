---
// Card: structure only. Its figure and footer are other components, given as data
// ({ component, data }) and loaded by title; the card imports none of them.
const modules = import.meta.glob<{ default: any }>(["../*/*.svelte", "../*/*.astro", "!./Card.astro"]);

type Child = { component?: string; data?: Record<string, unknown> };

async function load(child: Child | undefined) {
  // Purpose: the component a child names, with its data, or undefined
  const name = child?.component;
  if (typeof name !== "string" || !/^[A-Z][A-Za-z0-9]*$/.test(name)) return undefined;
  const loader = modules[`../${name}/${name}.svelte`] ?? modules[`../${name}/${name}.astro`];
  return loader ? { Component: (await loader()).default, data: child?.data ?? {} } : undefined;
}

const {
  as: Tag = "article",
  header,
  text,
  figure,
  footer,
  class: className = "",
  ...rest
} = Astro.props as Record<string, any>;

const figureChild = await load(figure);
const footerChild = await load(footer);
const classes = ["card", className].filter(Boolean).join(" ");
---
<Tag class={classes} {...rest}>
  <figure class="frame">
    {figureChild && <figureChild.Component {...figureChild.data} />}
    <slot name="figure" />
  </figure>
  <div class="stack box">
    {header && <h3>{header}</h3>}
    {text && <p>{text}</p>}
    <slot />
    {footerChild && <footer class="push"><footerChild.Component {...footerChild.data} /></footer>}
  </div>
</Tag>
