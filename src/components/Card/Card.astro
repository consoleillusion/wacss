---
import Button from "../Button/Button.astro";

// Every component folder is listed here, but a component is only fetched when
// a card is given its name. Card never imports them itself.
const loaders = import.meta.glob("../*/*.astro") as Record<string, () => Promise<{ default: any }>>;

// Figures given by media type render with the matching component.
const MEDIA_COMPONENT: Record<string, string> = { image: "Image", video: "Video", audio: "Audio" };

type Request = { name: string; props: Record<string, unknown> };

function loaderFor(name: unknown) {
  // Purpose: Find the loader for a component name, or undefined when no such component exists.
  if (typeof name !== "string" || !/^[A-Z][A-Za-z0-9]*$/.test(name)) return undefined;
  const key = `../${name}/${name}.astro`;
  return Object.hasOwn(loaders, key) ? loaders[key] : undefined;
}

function figureRequest(f: any): Request | undefined {
  // Purpose: Turn figure data into the component name and props it asks for, or undefined.
  if (!f || typeof f !== "object") return undefined;
  const { type, component: named, schema, data: d, title: figureTitle, ...rest } = f;
  const name =
    typeof type === "string" && Object.hasOwn(MEDIA_COMPONENT, type) ? MEDIA_COMPONENT[type]
    : typeof named === "string" ? named
    : typeof schema?.title === "string" ? schema.title
    : typeof figureTitle === "string" ? figureTitle
    : undefined;
  if (!name || !loaderFor(name)) return undefined;
  return { name, props: d && typeof d === "object" ? d : rest };
}

async function resolve(request: Request | undefined) {
  // Purpose: Fetch the component a request names and pair it with its props.
  const loader = request && loaderFor(request.name);
  if (!request || !loader) return undefined;
  return { Comp: (await loader()).default, props: request.props };
}

const {
  as: Tag = "article"
  , title
  , description
  , footer
  , figure
  , media
  , content
  , component
  , data = {}
  , href
  , ctaLabel = "Open component"
  , class: className = ""
  , ...rest
} = Astro.props as any;

const bodyRequest: Request | undefined = component
  ? { name: component, props: data }
  : content?.component
    ? { name: content.component, props: content.data ?? {} }
    : undefined;
const body = await resolve(bodyRequest);
const figureBody = await resolve(figureRequest(figure ?? media));
const textContent = typeof content === "string" ? content : content?.text;
const hasContent = Boolean(body || textContent || Astro.slots.has("default"));
---
<Tag wacss="card" class={["card", className].filter(Boolean).join(" ")} {...rest}>
  {(title || description) && (
    <header wacss="card-header">
      {title && <h3 wacss="card-title">{title}</h3>}
      {description && <p wacss="card-description">{description}</p>}
    </header>
  )}
  {(hasContent || footer || href) && (
    <div wacss="card-content">
      {figureBody && (
        <figure wacss="card-media">
          <figureBody.Comp {...figureBody.props} />
        </figure>
      )}
      {body && <body.Comp {...body.props} />}
      {textContent && <p>{textContent}</p>}
      <slot />
      {(footer || href) && (
        <footer wacss="card-footer">
          {footer}
          {href && (
            <Button href={href} variant="secondary" data-slot="card-cta">
              <span>{ctaLabel}</span>
            </Button>
          )}
        </footer>
      )}
    </div>
  )}
</Tag>
