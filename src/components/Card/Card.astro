---
// Card: structure only. The figure row renders the component its data names (by title);
// the body row holds the header, text and footer. Card imports no component except Button.
import Button from "../Button/Button.svelte";

const modules = import.meta.glob<{ default: any }>(["../*/*.svelte", "../*/*.astro", "!./Card.astro"]);

function loaderFor(name: unknown) {
  // Purpose: find the module of the component a figure names, or undefined
  if (typeof name !== "string" || !/^[A-Z][A-Za-z0-9]*$/.test(name)) return undefined;
  return modules[`../${name}/${name}.svelte`] ?? modules[`../${name}/${name}.astro`];
}

const {
  variant = "secondary",
  as: Tag = "article",
  header,
  text,
  figure,
  footer,
  href,
  ctaLabel = "Open component",
  class: className = "",
  ...rest
} = Astro.props as Record<string, any>;

const { title: figureName, ...figureProps } = figure ?? {};
const loader = loaderFor(figureName);
const Figure = loader ? (await loader()).default : undefined;
const classes = ["card", variant === "secondary" ? "" : variant, className].filter(Boolean).join(" ");
---
<Tag class={classes} {...rest}>
  <figure class="card-figure">
    {Figure && <Figure {...figureProps} />}
    <slot name="figure" />
  </figure>
  <div class="card-body">
    {header && <h3>{header}</h3>}
    {text && <p>{text}</p>}
    <slot />
    {(footer || href) && (
      <footer>
        {footer}
        {href && <Button href={href} label={ctaLabel} />}
      </footer>
    )}
  </div>
</Tag>
