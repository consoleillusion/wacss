---
interface AccordionItem {
  value: string;
  title: string;
  content?: string;
  disabled?: boolean;
}

interface Props {
  items?: AccordionItem[];
  type?: "single" | "multiple";
  value?: string | string[];
  name?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  items = [],
  type = "single",
  value = "",
  name,
  class: className = "",
  ...rest
} = Astro.props as Props;

const groupName = type === "single" ? (name ?? "wacss-accordion") : undefined;
const classes = [className].filter(Boolean).join(" ");

const isOpen = (itemValue: string) => {
  if (Array.isArray(value)) return value.includes(itemValue);
  return value === itemValue;
};
---
<section {...rest} class={classes || undefined} wacss="accordion">
  {items.map((item) => {
    const open = isOpen(item.value);
    return (
      <details name={groupName} open={open || undefined}>
        <summary>
          <span>{item.title}</span>
          <svg
            viewBox="0 0 16 16"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m4 6 4 4 4-4" />
          </svg>
        </summary>
        <div>
          {item.content && <p>{item.content}</p>}
          <slot name={item.value} />
        </div>
      </details>
    );
  })}
  <slot />
</section>
