---
import "../../../dist/wacss.min.css";
import { schemas } from "../../spec/index";
import SiteNav from "../../components/SiteNav.astro";
import TooltipClient from "../../components/Tooltip/TooltipClient.svelte";

function renderSchema(obj: Record<string, unknown>, depth = 0): string {
  if (!obj || typeof obj !== "object") return String(obj ?? "");
  const indent = "  ".repeat(depth);
  const lines: string[] = [];
  for (const [key, value] of Object.entries(obj)) {
    if (key === "properties") {
      lines.push(`${indent}${key}:`);
      lines.push(renderSchema(value as Record<string, unknown>, depth + 1));
    } else if (typeof value === "object" && value !== null && !Array.isArray(value)) {
      lines.push(`${indent}${key}:`);
      lines.push(renderSchema(value as Record<string, unknown>, depth + 1));
    } else if (Array.isArray(value)) {
      lines.push(`${indent}${key}: [${value.map((v) => String(v)).join(", ")}]`);
    } else {
      lines.push(`${indent}${key}: ${JSON.stringify(value)}`);
    }
  }
  return lines.join("\n");
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>wacss · Tooltip</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("wacss:theme");
          if (stored === "dark" || stored === "light") document.documentElement.classList.add(stored);
        } catch {}
      })();
    </script>
  </head>
  <body>
    <SiteNav current="/components/" />
    <div style="max-width: 72rem; margin: 0 auto; padding: 0 var(--space-4) var(--space-8);">

    <h1>Tooltip</h1>
    <p style="color: var(--text-muted); margin-block-end: var(--space-5);">
      A thin bits-ui wrapper, rendered client-side because it needs a context provider. The ten core wacss components are the high-level, data-driven API.
    </p>

    <section style="margin-block-end: var(--space-7); border-block-start: var(--border-width-ui) solid var(--color-border); padding-block-start: var(--space-4);">
      <h2 style="font-size: var(--font-size-heading-3); margin-block-end: var(--space-3);">Preview</h2>
      <div style="padding: var(--space-4); background: var(--color-surface); border: var(--border-width-ui) solid var(--color-border); border-radius: var(--radius-md);">
        <TooltipClient client:load />
      </div>
    </section>

    <section>
      <h2 style="font-size: var(--font-size-heading-3); margin-block-end: var(--space-3);">Schema (Tooltip)</h2>
      <pre style="padding: var(--space-4); background: var(--color-surface); border: var(--border-width-ui) solid var(--color-border); border-radius: var(--radius-md); overflow-x: auto; white-space: pre-wrap; font-family: var(--font-family-mono); font-size: 0.9em;">
{renderSchema(schemas.tooltip)}
          </pre>
    </section>
    </div>
  </body>
</html>
