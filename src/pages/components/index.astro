---
import "../../../dist/wacss.min.css";
import { schemas } from "../../spec/index";
import SiteNav from "../../components/SiteNav.astro";

const list = Object.entries(schemas).map(([key, s]) => ({ key, title: s.title }));
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>wacss · Components</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("wacss:theme");
          if (stored === "dark" || stored === "light") document.documentElement.classList.add(stored);
        } catch {}
      })();
    </script>
  </head>
  <body>
    <SiteNav current="/components/" />
    <div data-wacss="page">
      <h1>Components</h1>
      <p data-wacss="muted mb-5">
        Each page shows a live preview and the component schema. The core components are high-level and data-driven; the rest are thin bits-ui wrappers kept for comparison.
      </p>
      <ul data-wacss="list-disc">
        {list.map((item) => (
          <li>
            <a href={`/components/${item.key}/`}>{item.title}</a>
          </li>
        ))}
      </ul>
    </div>
  </body>
</html>
