---
import "../../dist/wacss.min.css";
import { Card } from "../components";
import SiteNav from "../components/SiteNav.astro";
import { schemas } from "../spec/index";

const accordionItems = [
  { value: "one", title: "Token driven", content: "Change tokens, restyle the interface." },
  { value: "two", title: "Data driven", content: "Pass data props, get a full UI." },
];

const selectOptions = [
  { value: "sakura", label: "Sakura" },
  { value: "shibui", label: "Shibui" },
  { value: "sumi", label: "Sumi" },
];

const tabs = [
  { value: "overview", label: "Overview", content: "Composable, token-driven components." },
  { value: "tokens", label: "Tokens", content: "Primitive → alias → component → state." },
];

const navMenuItems = [
  { label: "Getting started", links: [
    { href: "/components/", label: "Introduction", description: "Explore components." },
    { href: "/components/button/", label: "Button", description: "Actions and variants." },
  ]},
  { label: "Components", href: "/components/" },
];

const showcase = [
  { key: "button", figure: { title: "Button", variant: "default", label: "Primary action" } },
  { key: "badge", figure: { title: "Badge", label: "Badge" } },
  { key: "avatar", figure: { title: "Avatar", alt: "Ada Lovelace", fallback: "AL" } },
  { key: "input", figure: { title: "Input", label: "Email", type: "email", placeholder: "you@example.com" } },
  { key: "slider", figure: { component: "Slider", accentSelector: true } },
  { key: "colorpicker", figure: { component: "ColorPicker", label: "Color", value: "#6d9469" } },
  { key: "datepicker", figure: { component: "DatePicker", label: "Date" } },
  { key: "navigationmenu", figure: { component: "NavigationMenu", items: navMenuItems } },
  { key: "checkbox", figure: { title: "Checkbox", label: "Accept terms", description: "Remembered in localStorage." } },
  { key: "switch", figure: { title: "Switch", label: "Notifications" } },
  { key: "select", figure: { title: "Select", options: selectOptions, placeholder: "Choose accent", accentSelector: true, storageKey: "wacss:accent" } },
  { key: "progress", figure: { title: "Progress", value: 62, label: "Progress", showValue: true } },
  { key: "separator", figure: { title: "Separator" } },
  { key: "tabs", figure: { title: "Tabs", tabs } },
  { key: "accordion", figure: { title: "Accordion", items: accordionItems } },
  { key: "label", figure: { title: "Label", text: "Label", required: true } },
  { key: "image", figure: { title: "Image", src: "https://images.unsplash.com/photo-1515694346937-94d85e41e6f0?w=800&q=80&auto=format&fit=crop", alt: "Matcha tea", caption: "Matcha" } },
  { key: "video", figure: { title: "Video", src: "https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4", caption: "Sample video" } },
  { key: "audio", figure: { title: "Audio", src: "https://interactive-examples.mdn.mozilla.net/media/cc0-audio/t-rex-roar.mp3", caption: "Sample audio" } },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>wacss</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("wacss:theme");
          if (stored === "light" || stored === "dark") document.documentElement.setAttribute("data-theme", stored);
          const accent = localStorage.getItem("wacss:accent");
          const themes = ["sakura", "shibui", "sumi"];
          if (accent && themes.includes(accent)) document.documentElement.classList.add(`theme-${accent}`);
          else if (accent === "custom") {
            const c = localStorage.getItem("wacss:accent-color");
            if (c) { document.documentElement.style.setProperty("--color-theme", c); document.documentElement.style.setProperty("--color-accent", c); }
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    <SiteNav current="/" />
    <div data-wacss="page">
      <header data-wacss="page-header">
        <p><small>wacss · token-driven components</small></p>
        <h1>Calm interfaces, one token set</h1>
        <p data-wacss="page-lead">
          Data-driven components styled by a global token hierarchy. Each card below renders a component
          from schema-described data.
        </p>
      </header>

      <main>
        <section class="grid" data-fit data-wacss="component-grid">
          {showcase.map((item) => {
            const schemaKey = item.key === "colorpicker" ? "colorPicker" : item.key === "datepicker" ? "datePicker" : item.key === "navigationmenu" ? "navigationMenu" : item.key;
            const schema = (schemas as any)[schemaKey];
            return schema ? (
              <Card
                client:load
                header={schema.title}
                text={schema.description}
                figure={item.figure}
                href={`/components/${item.key}/`}
              />
            ) : null;
          })}
        </section>
      </main>
    </div>
  </body>
</html>
