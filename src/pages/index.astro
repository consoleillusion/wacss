---
import "../../dist/wacss.min.css";
import {
  Accordion,
  Button,
  Card,
  Checkbox,
  Dialog,
  Input,
  Label,
  Select,
  Switch,
  Tabs,
} from "../components";
import FormDemo from "../islands/FormDemo.svelte";
import SiteNav from "../components/SiteNav.astro";

const accordionItems = [
  {
    value: "tokens",
    title: "One token set restyles everything",
    content:
      "Primitive values feed alias roles, alias roles feed component tokens, and component tokens feed state values.",
  },
  {
    value: "global",
    title: "Global styles only",
    content:
      "Components carry no scoped styles. Paste a different token set at :root and the whole library follows.",
  },
  {
    value: "data",
    title: "Data in, UI out",
    content:
      "Pass items, options, tabs, or values. The component renders the full accessible interaction for you.",
  },
];

const selectOptions = [
  { value: "sakura", label: "Sakura" },
  { value: "matcha", label: "Matcha" },
  { value: "sumi", label: "Sumi" },
];

const tabs = [
  { value: "overview", label: "Overview", content: "A small, token-driven component set." },
  { value: "tokens", label: "Tokens", content: "Primitive, alias, component, state." },
  { value: "storage", label: "Storage", content: "Value-like state persists to localStorage." },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>wacss</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("wacss:theme");
          if (stored === "dark" || stored === "light") document.documentElement.classList.add(stored);
        } catch {}
      })();
    </script>
  </head>
  <body>
    <SiteNav current="/" />
    <div style="max-width: 72rem; margin: 0 auto; padding: 0 var(--space-4) var(--space-8);">
    <header style="margin-block-end: var(--space-7);">
      <p><small>wacss · token-driven components</small></p>
      <h1>Calm interfaces, one token set</h1>
      <p style="color: var(--text-muted); max-inline-size: var(--measure);">
        Components render from simple data props. Styling is global, and every value traces back to the
        primitive → alias → component → state token hierarchy.
      </p>
      <p style="display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: center;">
        <Button variant="default">Primary action</Button>
        <Button variant="secondary">Secondary</Button>
        <Button variant="outline">Outline</Button>
        <Button variant="ghost">Ghost</Button>
        <Button variant="destructive">Delete</Button>
        <Button variant="link" href="/components/">Component gallery →</Button>
      </p>
    </header>

    <main>
      <section style="display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); align-items: start;">
        <Card title="Card" description="A surface with optional title, description, content, and footer.">
          <p style="margin: 0; color: var(--text-muted);">
            Card content is ordinary markup. The card only supplies the surface and spacing.
          </p>
        </Card>

        <Card title="Form controls">
          <div style="display: grid; gap: var(--space-4);">
            <Input client:load label="Email" type="email" placeholder="you@example.com" description="Stored in localStorage by default." />
            <Input client:load label="Project name" placeholder="Untitled" />
            <Label for="demo-checkbox" text="Label" />
            <Checkbox client:load label="Accept terms" description="This checkbox remembers its state." />
            <Switch client:load label="Notifications" />
          </div>
        </Card>
      </section>

      <section style="margin-block-start: var(--space-7); display: grid; gap: var(--space-4);">
        <h2>Accordion</h2>
        <Accordion items={accordionItems} />

        <h2>Select</h2>
        <div style="max-inline-size: 20rem;">
          <Select options={selectOptions} placeholder="Choose a theme" client:load />
        </div>

        <h2>Tabs</h2>
        <Tabs tabs={tabs} client:load />

        <h2>Dialog</h2>
        <Dialog
          title="Edit profile"
          description="Make changes to your profile here. Click save when you are done."
          triggerLabel="Open dialog"
          client:load
        >
          <p style="margin: 0; color: var(--text-muted);">
            Dialog content is a snippet. Everything else is supplied by props.
          </p>
        </Dialog>

        <h2>Form from JSON Schema</h2>
        <p style="color: var(--text-muted); max-inline-size: var(--measure); margin: 0;">
          Pass a schema and the form infers text, email, number, switch, select, checkbox group,
          textarea, date, and nested object fields. Add <code>action</code> and <code>target</code>
          for native submission, or use <code>onSubmit</code> for client-side handling.
        </p>
        <FormDemo client:load />
      </section>
    </main>
    </div>
  </body>
</html>
