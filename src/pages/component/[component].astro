---
import "../../../dist/wacss.min.css";
import SiteNav from "../../components/SiteNav.astro";
import Button from "../../components/Button/Button.svelte";
import Card from "../../components/Card/Card.svelte";
import Input from "../../components/Input/Input.svelte";
import Label from "../../components/Label/Label.svelte";
import Accordion from "../../components/Accordion/Accordion.astro";
import Checkbox from "../../components/Checkbox/Checkbox.svelte";
import Switch from "../../components/Switch/Switch.svelte";
import Select from "../../components/Select/Select.svelte";
import Dialog from "../../components/Dialog/Dialog.svelte";
import Tabs from "../../components/Tabs/Tabs.svelte";
import Badge from "../../components/Badge/Badge.svelte";
import Separator from "../../components/Separator/Separator.svelte";
import Progress from "../../components/Progress/Progress.svelte";
import Avatar from "../../components/Avatar/Avatar.svelte";
import Popover from "../../components/Popover/Popover.svelte";
import DropdownMenu from "../../components/DropdownMenu/DropdownMenu.svelte";
import Toggle from "../../components/Toggle/Toggle.svelte";
import RadioGroup from "../../components/RadioGroup/RadioGroup.svelte";
import AlertDialog from "../../components/AlertDialog/AlertDialog.svelte";
import ContextMenu from "../../components/ContextMenu/ContextMenu.svelte";
import Slider from "../../components/Slider/Slider.svelte";
import Meter from "../../components/Meter/Meter.svelte";
import AspectRatio from "../../components/AspectRatio/AspectRatio.svelte";
import ColorPicker from "../../components/ColorPicker/ColorPicker.svelte";
import ColorInput from "../../components/ColorInput/ColorInput.svelte";
import DatePicker from "../../components/DatePicker/DatePicker.svelte";
import NavigationMenu from "../../components/NavigationMenu/NavigationMenu.svelte";
import Audio from "../../components/Audio/Audio.svelte";
import Field from "../../components/Field/Field.astro";
import Image from "../../components/Image/Image.svelte";
import Video from "../../components/Video/Video.svelte";
import Nav from "../../components/Nav/Nav.astro";
import Disclosure from "../../components/Disclosure/Disclosure.astro";
import DataTable from "../../components/DataTable/DataTable.svelte";
import PertChart from "../../components/PertChart/PertChart.svelte";
import TokenGraph from "../../components/TokenGraph/TokenGraph.svelte";
import { collectTokenLayers } from "../../spec/tokens";
import Alert from "../../components/Alert/Alert.svelte";
import Breadcrumb from "../../components/Breadcrumb/Breadcrumb.svelte";
import Pagination from "../../components/Pagination/Pagination.svelte";
import Skeleton from "../../components/Skeleton/Skeleton.svelte";
import Textarea from "../../components/Textarea/Textarea.svelte";
import FormDemo from "../../islands/FormDemo.svelte";

import { schemas } from "../../spec/index";
import { ClientRouter } from "astro:transitions";
import ThemeScript from "../../components/ThemeScript.astro";
const entry: string = (Astro.params.component ?? "").toLowerCase();

const accordionItems = [
  { value: "one", title: "First item", content: "The accordion renders from an items array." },
  { value: "two", title: "Second item", content: "Only one item is open at a time by default." },
  { value: "three", title: "Third item", content: "Set type=\"multiple\" to open several." },
];

const selectOptions = [
  { value: "sakura", label: "Sakura" },
  { value: "matcha", label: "Matcha" },
  { value: "sumi", label: "Sumi" },
  { value: "aizome", label: "Aizome" },
  { value: "kurenai", label: "Kurenai" },
];

const tabs = [
  { value: "overview", label: "Overview", content: "Data-driven tabs with persisted selection." },
  { value: "usage", label: "Usage", content: "Pass a tabs array and the component renders the rest." },
  { value: "tokens", label: "Tokens", content: "Every visual value comes from a component or state token." },
];

const datatableColumns = [
  { id: "version", header: "Version", width: 90, sort: true },
  { id: "title", header: "Release", flexgrow: 1, editor: "text" },
  { id: "date", header: "Date", width: 120, sort: true, editor: "datepicker" },
  {
    id: "status",
    header: "Status",
    width: 120,
    editor: {
      type: "richselect",
      config: {
        options: [
          { id: "Current", label: "Current" },
          { id: "Shipped", label: "Shipped" },
          { id: "Fix", label: "Fix" },
        ],
      },
    },
  },
];
const datatableRows = [
  { id: 1, version: "0.2.0", title: "DataTable component", date: "2026-11-13", status: "Current" },
  { id: 2, version: "0.1.2", title: "Theme persists across view transitions", date: "2026-11-05", status: "Fix" },
  { id: 3, version: "0.1.0", title: "Initial component set", date: "2026-10-28", status: "Shipped" },
  { id: 4, version: "0.0.9", title: "Token hierarchy rulebook", date: "2026-10-21", status: "Shipped" },
  { id: 5, version: "0.0.8", title: "Card figures bleed to the edge", date: "2026-10-14", status: "Shipped" },
];

const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: "Components", href: "/component/" },
  { label: "Breadcrumb" },
];

const tokenLayers = collectTokenLayers();

const pertTasks = [
  { id: "A", name: "Requirements", optimistic: 3, likely: 5, pessimistic: 9 },
  { id: "B", name: "Design", optimistic: 3, likely: 5, pessimistic: 8, dependsOn: ["A"] },
  { id: "C", name: "Frontend", optimistic: 5, likely: 8, pessimistic: 14, dependsOn: ["B"] },
  { id: "D", name: "Backend", optimistic: 4, likely: 6, pessimistic: 10, dependsOn: ["B"] },
  { id: "E", name: "QA", optimistic: 3, likely: 5, pessimistic: 8, dependsOn: ["C"] },
  { id: "F", name: "Performance", optimistic: 2, likely: 4, pessimistic: 6, dependsOn: ["D"] },
  { id: "G", name: "Staging deploy", optimistic: 1, likely: 2, pessimistic: 4, dependsOn: ["E", "F"] },
  { id: "H", name: "Launch", optimistic: 1, likely: 1, pessimistic: 2, dependsOn: ["G"] },
];

const COMPONENTS: Record<string, { Component: unknown; schema: Record<string, unknown> }> = {
  audio: { Component: Audio, schema: schemas.audio },
  button: { Component: Button, schema: schemas.button },
  card: { Component: Card, schema: schemas.card },
  input: { Component: Input, schema: schemas.input },
  form: { Component: FormDemo, schema: schemas.form },
  label: { Component: Label, schema: schemas.label },
  accordion: { Component: Accordion, schema: schemas.accordion },
  checkbox: { Component: Checkbox, schema: schemas.checkbox },
  switch: { Component: Switch, schema: schemas.switch },
  select: { Component: Select, schema: schemas.select },
  dialog: { Component: Dialog, schema: schemas.dialog },
  tabs: { Component: Tabs, schema: schemas.tabs },
  badge: { Component: Badge, schema: schemas.badge },
  separator: { Component: Separator, schema: schemas.separator },
  progress: { Component: Progress, schema: schemas.progress },
  avatar: { Component: Avatar, schema: schemas.avatar },
  popover: { Component: Popover, schema: schemas.popover },
  dropdownmenu: { Component: DropdownMenu, schema: schemas.dropdownMenu },
  toggle: { Component: Toggle, schema: schemas.toggle },
  radiogroup: { Component: RadioGroup, schema: schemas.radioGroup },
  alertdialog: { Component: AlertDialog, schema: schemas.alertDialog },
  contextmenu: { Component: ContextMenu, schema: schemas.contextMenu },
  slider: { Component: Slider, schema: schemas.slider },
  meter: { Component: Meter, schema: schemas.meter },
  aspectratio: { Component: AspectRatio, schema: schemas.aspectRatio },
  color: { Component: ColorInput, schema: schemas.color },
  colorpicker: { Component: ColorPicker, schema: schemas.colorPicker },
  datepicker: { Component: DatePicker, schema: schemas.datePicker },
  navigationmenu: { Component: NavigationMenu, schema: schemas.navigationMenu },
  field: { Component: Field, schema: schemas.field },
  table: { Component: null, schema: schemas.table },
  nav: { Component: Nav, schema: schemas.nav },
  disclosure: { Component: Disclosure, schema: schemas.disclosure },
  image: { Component: Image, schema: schemas.image },
  video: { Component: Video, schema: schemas.video },
  datatable: { Component: DataTable, schema: schemas.datatable },
  pertchart: { Component: PertChart, schema: schemas.pertChart },
  tokengraph: { Component: TokenGraph, schema: schemas.tokenGraph },
  alert: { Component: Alert, schema: schemas.alert },
  breadcrumb: { Component: Breadcrumb, schema: schemas.breadcrumb },
  pagination: { Component: Pagination, schema: schemas.pagination },
  skeleton: { Component: Skeleton, schema: schemas.skeleton },
  textarea: { Component: Textarea, schema: schemas.textarea },
};

const componentInfo = COMPONENTS[entry];
if (!componentInfo) {
  throw new Error(`No demo entry registered for component "${entry}" — add one to COMPONENTS.`);
}

/* tooltip.astro is a dedicated page; everything else with a schema gets an endpoint. */
export async function getStaticPaths() {
  const { schemas: allSchemas } = await import("../../spec/index");
  const keys = Object.keys(allSchemas).map((key) => key.toLowerCase()).filter((key) => key !== "tooltip");
  return keys.map((component) => ({ params: { component } }));
}

function renderSchema(obj: Record<string, unknown>, depth = 0): string {
  if (!obj || typeof obj !== "object") return String(obj ?? "");
  const indent = "  ".repeat(depth);
  const lines: string[] = [];
  for (const [key, value] of Object.entries(obj)) {
    if (key === "properties") {
      lines.push(`${indent}${key}:`);
      lines.push(renderSchema(value as Record<string, unknown>, depth + 1));
    } else if (typeof value === "object" && value !== null && !Array.isArray(value)) {
      lines.push(`${indent}${key}:`);
      lines.push(renderSchema(value as Record<string, unknown>, depth + 1));
    } else if (Array.isArray(value)) {
      lines.push(
        `${indent}${key}: [${value
          .map((v) => (typeof v === "object" && v !== null ? JSON.stringify(v) : String(v)))
          .join(", ")}]`,
      );
    } else {
      lines.push(`${indent}${key}: ${JSON.stringify(value)}`);
    }
  }
  return lines.join("\n");
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />
    <title>wacss · {componentInfo ? componentInfo.schema.title : entry}</title>
    <ThemeScript />
  </head>
  <body>
    <SiteNav current="/component/" />
    <main>

    {componentInfo ? (
      <>
        <h1>{componentInfo.schema.title}</h1>
        <p>
          A high-level wacss component. Pass data props and let the component render the rest.
        </p>

        <section>
          <h2>Preview</h2>
          <div>
            {entry === "audio" && <Audio client:load src="https://interactive-examples.mdn.mozilla.net/media/cc0-audio/t-rex-roar.mp3" caption="Sample audio" />}
            {entry === "button" && <Button client:load>Save changes</Button>}
            {entry === "card" && (
              <Card client:load title="Card title" description="A short description of the card.">
                <p>Card content goes here.</p>
              </Card>
            )}
            {entry === "field" && (
              <Field id="demo-field" label="Full name" help="Stored on your profile.">
                <Input client:load id="demo-field" placeholder="Ada Lovelace" aria-describedby="demo-field-help" />
              </Field>
            )}
            {entry === "nav" && (
              <Nav label="Primary">
                <a href="/">Home</a>
                <a href="/component/">Components</a>
              </Nav>
            )}
            {entry === "disclosure" && (
              <Disclosure summary="Why native details?" open>
                <p>Renders as an accessible, browser-native disclosure with no JS.</p>
              </Disclosure>
            )}
            {entry === "table" && (
              <table>
                <caption>Release cadence</caption>
                <thead>
                  <tr><th scope="col">Release</th><th scope="col">Status</th><th scope="col">Notes</th></tr>
                </thead>
                <tbody>
                  <tr><td>0.2.0</td><td>Current</td><td>DataTable, schema-driven docs</td></tr>
                  <tr><td>0.1.0</td><td>Shipped</td><td>Initial component set</td></tr>
                </tbody>
              </table>
            )}
            {entry === "datatable" && (
              <div style="inline-size: 100%; block-size: 18rem;">
                <DataTable client:load data={datatableRows} columns={datatableColumns} />
              </div>
            )}
            {entry === "alert" && (
              <div class="stack" data-gap="3">
                <Alert title="Heads up" description="This is an informational alert." />
                <Alert variant="positive" title="Saved" description="Your changes were stored locally." />
                <Alert variant="destructive" title="Not enough tokens" description="Add at least three items before trying to remove them." />
              </div>
            )}
            {entry === "breadcrumb" && <Breadcrumb items={breadcrumbItems} />}
            {entry === "pagination" && <Pagination client:load total={87} perPage={10} />}
            {entry === "skeleton" && (
              <div class="stack" data-gap="3">
                <Skeleton circle />
                <Skeleton lines={3} />
              </div>
            )}
            {entry === "textarea" && <Textarea client:load label="Notes" placeholder="Write something memorable…" description="Stored in localStorage by default." rows={5} />}
            {entry === "tokengraph" && (
              <div style="inline-size: 100%; block-size: calc(100vh - 4rem);">
                <TokenGraph client:load layers={tokenLayers} />
              </div>
            )}
            {entry === "pertchart" && (
              <div style="inline-size: 100%; block-size: 26rem;">
                <PertChart client:load tasks={pertTasks} />
              </div>
            )}
            {entry === "image" && <Image client:load src="https://images.unsplash.com/photo-1515694346937-94d85e41e6f0?w=800&q=80&auto=format&fit=crop" alt="Matcha tea" />}
            {entry === "video" && <Video client:load src="https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4" />}
            {entry === "input" && (
              <Input client:load label="Email" type="email" placeholder="you@example.com" description="Stored in localStorage by default." required />
            )}
            {entry === "form" && <FormDemo client:load />}
            {entry === "label" && <Label client:load for="demo-label" text="Label" />}
            {entry === "accordion" && <Accordion items={accordionItems} />}
            {entry === "checkbox" && <Checkbox client:load label="Accept terms" description="This checkbox remembers its state." />}
            {entry === "switch" && <Switch client:load label="Notifications" />}
            {entry === "select" && <Select client:load options={selectOptions} placeholder="Choose accent" accentSelector storageKey="wacss:accent" />}
            {entry === "dialog" && (
              <Dialog client:load title="Edit profile" description="Make changes to your profile here." triggerLabel="Open dialog">
                <p>Dialog body content.</p>
              </Dialog>
            )}
            {entry === "tabs" && <Tabs client:load tabs={tabs} />}
            {entry === "badge" && (
              <div data-gap="2">
                <Badge>Default</Badge>
                <Badge variant="secondary">Secondary</Badge>
                <Badge variant="destructive">Destructive</Badge>
                <Badge variant="outline">Outline</Badge>
              </div>
            )}
            {entry === "separator" && (
              <div>
                <div data-gap="2">
                  <span>Horizontal</span>
                  <Separator />
                </div>
                <div data-height="2rem">
                  <span>Left</span>
                  <Separator orientation="vertical" />
                  <span>Right</span>
                </div>
              </div>
            )}
            {entry === "progress" && <Progress client:load value={62} label="Progress" showValue />}
            {entry === "avatar" && (
              <div>
                <Avatar alt="Ada Lovelace" fallback="AL" size="sm" />
                <Avatar alt="Ada Lovelace" fallback="AL" />
                <Avatar alt="Ada Lovelace" fallback="AL" size="lg" />
              </div>
            )}
            {entry === "popover" && <Popover client:load />}
            {entry === "dropdownMenu" && <DropdownMenu client:load />}
            {entry === "toggle" && <Toggle client:load />}
            {entry === "radioGroup" && <RadioGroup client:load />}
            {entry === "alertDialog" && <AlertDialog client:load />}
            {entry === "contextMenu" && <ContextMenu client:load />}
            {entry === "slider" && <Slider client:load value={40} aria-label="Slider" />}
            {entry === "meter" && <Meter client:load />}
            {entry === "aspectRatio" && <AspectRatio client:load />}
            {entry === "color" && <ColorInput client:load label="Accent" value="#6d9469" accentSelector />}
            {entry === "colorpicker" && <ColorPicker client:load label="Color" value="#6d9469" />}
            {entry === "datepicker" && <DatePicker client:load label="Date" />}
            {entry === "navigationmenu" && (
              <NavigationMenu client:load items={[
                { label: "Getting started", links: [
                  { href: "#", label: "Introduction", description: "Token-driven global CSS components." },
                  { href: "#", label: "Installation", description: "Add dist/wacss.css to your project." },
                ]},
                { label: "Components", links: [
                  { href: "/component/button/", label: "Button", description: "Actions and variants." },
                  { href: "/component/form/", label: "Form", description: "JSON Schema-driven forms." },
                ]},
                { label: "Docs", href: "/component/" },
              ]} />
            )}
          </div>
        </section>

        <section>
          <h2>Schema ({componentInfo.schema.title})</h2>
          <pre>{renderSchema(componentInfo.schema)}</pre>
        </section>
      </>
    ) : (
      <>
        <h1>Component not found</h1>
        <p>No component registered for "{entry}".</p>
        <p>Available: {Object.keys(COMPONENTS).sort().join(", ")}.</p>
      </>
    )}
    </main>
  </body>
</html>
