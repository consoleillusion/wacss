---
import "../../../dist/wacss.min.css";
import { schemas } from "../../spec/index";
import SiteNav from "../../components/SiteNav.astro";
import TooltipClient from "../../components/Tooltip/TooltipClient.svelte";
import { ClientRouter } from "astro:transitions";
import ThemeScript from "../../components/ThemeScript.astro";

function renderSchema(obj: Record<string, unknown>, depth = 0): string {
  if (!obj || typeof obj !== "object") return String(obj ?? "");
  const indent = "  ".repeat(depth);
  const lines: string[] = [];
  for (const [key, value] of Object.entries(obj)) {
    if (key === "properties") {
      lines.push(`${indent}${key}:`);
      lines.push(renderSchema(value as Record<string, unknown>, depth + 1));
    } else if (typeof value === "object" && value !== null && !Array.isArray(value)) {
      lines.push(`${indent}${key}:`);
      lines.push(renderSchema(value as Record<string, unknown>, depth + 1));
    } else if (Array.isArray(value)) {
      lines.push(`${indent}${key}: [${value.map((v) => String(v)).join(", ")}]`);
    } else {
      lines.push(`${indent}${key}: ${JSON.stringify(value)}`);
    }
  }
  return lines.join("\n");
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />
    <title>wacss · Tooltip</title>
    <ThemeScript />
  </head>
  <body>
    <SiteNav current="/component/" />
    <main>
      <h1>Tooltip</h1>
      <p>
        A thin bits-ui wrapper, rendered client-side because it needs a context provider. The ten core wacss components are the high-level, data-driven API.
      </p>

      <section>
        <h2>Preview</h2>
        <div>
          <TooltipClient client:load />
        </div>
      </section>

      <section>
        <h2>Schema (Tooltip)</h2>
        <pre>{renderSchema(schemas.tooltip)}</pre>
      </section>
    </main>
  </body>
</html>
